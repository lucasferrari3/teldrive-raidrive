# Copy this file to .env and fill in your values:
#   copy .env.example .env          (Windows)
#   cp .env.example .env            (Linux)

# Backend: teldrive (default) or webdav
BACKEND=teldrive

# --- Teldrive (BACKEND=teldrive) ---
# Docs: https://teldrive-docs.pages.dev/docs/guides/rclone
TELDRIVE_API_HOST=http://127.0.0.1:8080
# Cookie "access_token" from the Teldrive web UI (Cookie Editor / DevTools)
TELDRIVE_ACCESS_TOKEN=
# Optional: API key auth (X-Api-Key) used by newer rclone forks
# TELDRIVE_API_KEY=

# --- WebDAV (BACKEND=webdav) ---
# WEBDAV_URL=http://127.0.0.1:5000/webdav
# WEBDAV_USER=admin
# WEBDAV_PASSWORD=changeme

# Windows: drive letter. Linux: folder path.
MOUNT_POINT=T:
# MOUNT_POINT=/mnt/telegram

# --- Cache / streaming ---
# Size of each Range GET / cache chunk (MiB). Streaming: 4
BLOCK_MIB=4
PREFETCH_BLOCKS=4
PREFETCH_AFTER=2
# Cold start: first Range size before full BLOCK (Play latency)
FAST_FIRST_MIB=1
# PREFETCH_WORKERS=2

# Disk cache directory (per-block .blk). Empty = RAM-only.
# Windows example: CACHE_DIR=D:\cache-tg
# Linux example:   CACHE_DIR=/var/cache/teldrive-raidrive
CACHE_DIR=
CACHE_MIB=2048
CACHE_READ_TTL=12:00:00
CACHE_CLEAN_INTERVAL=1:00:00
RAM_CACHE_MIB=512

# Teldrive list page size (max 1000)
PAGE_SIZE=500
META_TTL=300
NEGATIVE_META_TTL=120

# 1 = read-only (default). 0 = create/write/delete/rename (upload on close)
READ_ONLY=1
# Upload part size when READ_ONLY=0 (MiB)
UPLOAD_CHUNK_MIB=64
# Optional Telegram channel id (0 = Teldrive default)
CHANNEL_ID=0

# --- Windows / Dokany ---
# Dokany request timeout (milliseconds). Remote Telegram can be slow.
DOKAN_TIMEOUT_MS=300000
DOKAN_BRIDGE_WORKERS=4
# 1 = serialize Dokany callbacks (more stable). 0 = multi-thread
DOKAN_SINGLE_THREAD=1
# DOKAN_DEBUG=1

# --- Linux / FUSE ---
MODE=775
# MOUNT_UID=1000
# MOUNT_GID=1000
ALLOW_OTHER=0
